# Local overrides for compose. Copy to .env; it is gitignored.
# Production values are rendered onto the VPS by the stampyx-infra deploy workflow.

POSTGRES_PASSWORD=stampyx
KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-secret
STAMPYX_PROVISIONING_SECRET=local-dev-secret
STAMPYX_ACCOUNT_AUTO_APPROVE=true
# Domains the platform owns, comma separated. Seeded verified at boot; their DNS is published
# by us, not proved by a challenge TXT.
STAMPYX_PLATFORM_DOMAINS=stampyx.com
# Signs panel tokens for mailbox users. At least 32 chars; generate a real one for production.
STAMPYX_JWT_SECRET=local-dev-secret-local-dev-secret
STAMPYX_ADMIN_ROLE=stampyx-admin
MAIL_INTERNAL_SECRET=local-dev-secret
MAIL_MASTER_PASSWORD=local-dev-secret

MAIL_HOSTNAME=mail.stampyx.com
MAIL_PUBLIC_IP=127.0.0.1
DMARC_REPORT_EMAIL=dmarc@stampyx.com

LOG_LEVEL=debug
LOG_PRETTY=true
